# Server Environment Variables
# Copy to .env and fill in your values

PORT=5000
NODE_ENV=development

# Neon PostgreSQL
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# JWT Secrets (use strong random strings, 32+ chars)
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars

# Optional: extra CORS origins (comma-separated). Defaults always include:
#   dev  → http://localhost:3000
#   prod → https://cravon-frontend.onrender.com
# CLIENT_URL=http://localhost:3002

# Optional: override auto frontend URL (normally not needed)
# FRONTEND_URL=http://localhost:3000

# Production backend URL (for Google OAuth callback if GOOGLE_CALLBACK_URL unset)
# API_URL=https://your-backend.onrender.com

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ─── SMTP (password reset emails) ───────────────────────────────────────────
# Required in production. In development, if SMTP_HOST is unset, reset links are
# printed to the server console instead of emailed.
#
# Gmail example:
#   1. Google Account → Security → 2-Step Verification (enable)
#   2. App passwords → create password for "Mail"
#   3. Use that 16-char password as SMTP_PASS
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Cravon" <noreply@cravon.com>

# Google Gemini API (for AI Food Assistant)
GEMINI_API_KEY=your_gemini_api_key_here
