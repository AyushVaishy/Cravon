# Server Environment Variables
# Copy to .env and fill in your values

PORT=5000
NODE_ENV=development

# Neon PostgreSQL
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# JWT Secrets (use strong random strings, 32+ chars)
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars
# Optional token lifetimes (defaults: 15m access, 7d refresh)
# JWT_ACCESS_EXPIRES=15m
# JWT_REFRESH_EXPIRES=7d

# Optional: extra CORS origins (comma-separated). Defaults always include:
#   dev  → http://localhost:3000
#   prod → https://cravon-frontend.onrender.com
# CLIENT_URL=http://localhost:3002

# Optional: override auto frontend URL (normally not needed)
# FRONTEND_URL=http://localhost:3000

# Production backend URL (for Google OAuth callback if GOOGLE_CALLBACK_URL unset)
# API_URL=https://your-backend.onrender.com

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Facebook OAuth — https://developers.facebook.com
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# ─── Email (password reset) ─────────────────────────────────────────────────
# Production on Render free tier: use SendGrid API (SMTP ports are blocked).
# Local dev: SendGrid also works; or omit SENDGRID_API_KEY and use Gmail SMTP.
#
# SendGrid (recommended for production):
#   1. https://sendgrid.com → create API key
#   2. Settings → Sender Authentication → verify single sender email
#   3. Set SENDGRID_API_KEY + EMAIL_FROM (must match verified sender)
#
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
EMAIL_FROM=Cravon <your-verified-email@gmail.com>
#
# Optional: delivery / browse radius in km (defaults: 15 browse, 12 delivery)
# BROWSE_RADIUS_KM=15
# DELIVERY_RADIUS_KM=12

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Cravon" <your-email@gmail.com>

# Optional: forgot-password rate limit per IP (production only, default 10 per 15 min)
# FORGOT_PASSWORD_RATE_LIMIT_MAX=10
# VERIFICATION_RATE_LIMIT_MAX=10

# Optional: Google Maps / Places (location autocomplete + map picker)
# Enable Places API + Maps JavaScript API in Google Cloud Console
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Optional separate key for browser Maps JS (defaults to GOOGLE_MAPS_API_KEY)
# GOOGLE_MAPS_JS_KEY=your_browser_restricted_key
